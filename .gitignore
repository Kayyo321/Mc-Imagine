# Java/Gradle
build/
.gradle/
*.class
*.jar
# ...but the Gradle wrapper jar MUST be committed: it is what makes `./gradlew` work on a
# fresh clone. Without this negation `*.jar` swallows it and every clone fails with
# "Unable to access jarfile .../gradle-wrapper.jar" before Gradle even starts.
!**/gradle/wrapper/gradle-wrapper.jar
bin/
out/

# Python
__pycache__/
*.py[cod]
*$py.class
.venv/
venv/
ENV/
env/
dist/
*.egg-info/
*.egg

# IDE
.idea/
.vscode/
*.iml
*.ipr
*.iws
.eclipse/
.metadata/

# OS
.DS_Store
Thumbs.db
ehthumbs.db

# Model artifacts
*.mcim
*.onnx
*.pt
*.pth
*.ckpt
*.safetensors

# Datasets
data/raw/
data/processed/
*.sqlite3
model/data/
model/checkpoints/
model/training_runs/

# Logs
*.log
logs/
crash-reports/

# Env files
.env
.env.local
mod/fabric/run/

# Agent orchestration scratch state (not project source)
.agents/
.claude/
